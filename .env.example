
# Upstash REST credentials and a stable 64-character hexadecimal encryption key.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
MIST_ENCRYPTION_KEY=

# Neon PostgreSQL connection string for access-key accounts, encrypted TMDB keys and preferences.
DATABASE_URL=

# self-hosted proxy - not needed for local deployment
MKVDRAMA_PROXY_URL=
MEDIA_PROXY_URL=

# Optional media inspection limits per Mist process
MIST_FFPROBE_PROCESSES=2
MIST_FFPROBE_QUEUE=32
MIST_HLS_ANALYSIS_TTL_MS=30000
MIST_MEDIA_CACHE_MIB=64
