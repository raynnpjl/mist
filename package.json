{
  "name": "mist-chinese-addon",
  "version": "1.3.7",
  "private": true,
  "description": "Chinese streaming sources for existing Stremio and Nuvio catalogs",
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "start": "node dist/server.js",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "probe": "tsx scripts/probe.ts"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "express": "^4.22.3",
    "impers": "0.1.3",
    "stremio-addon-sdk": "^1.6.10"
  },
  "overrides": {
    "router": { "path-to-regexp": "^0.1.13" },
    "external-editor": { "tmp": "^0.2.6" }
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "@types/stremio-addon-sdk": "^1.6.12",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
